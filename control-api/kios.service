[Unit]
Description=Chromium Kiosk
After=graphical.target network-online.target
Wants=network-online.target
[Service]
User=cjiamram
Group=cjiamram
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/cjiamram/.Xauthority
Type=simple
ExecStartPre=/bin/sleep 5
ExecStart=chromium --password-store=basic --kiosk --noerrdialogs --disable-infobars --no-first-run https://cosai.nrru.ac.th/room-manager/qr-front?room=27.03.04
Restart=on-failure
RestartSec=5
[Install]
WantedBy=graphical.target