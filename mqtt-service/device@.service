[Unit]
Description=Device Listener - %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cjiamram
Group=cjiamram
WorkingDirectory=/opt/mqtt_sub
ExecStart=/opt/mqtt_sub/subenv/bin/python3 /opt/mqtt_sub/device_listener_arg.py --device %i
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=device_%i

[Install]
WantedBy=multi-user.target