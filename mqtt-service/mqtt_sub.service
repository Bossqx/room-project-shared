[Unit]
Description=MQTT Subscriber (test/ping) for 192.168.1.177:1883
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# --- User/Group: run as a dedicated non-root user (recommended) ---
# Create with: sudo useradd -r -s /usr/sbin/nologin mqttsub
User=mqttsub
Group=mqttsub

# --- Paths: adjust to where you place the script ---
WorkingDirectory=/opt/mqtt_sub
ExecStart=/usr/bin/python3 /opt/mqtt_sub/mqtt_sub.py

# --- Restart policy ---
Restart=on-failure
RestartSec=5

# --- Logging: send stdout/stderr to journal ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mqtt_sub

# --- Security hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mqtt_sub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
